<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed later for Supabase + remote artwork. Harmless to declare now. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      android:enableOnBackInvokedCallback is OFF on purpose.

      With it enabled, a gesture-navigation device feeds swipe progress to the
      system, which drags the window and any open panel along with the finger.
      The app's own close animations then fire on top of that, so two animations
      play over each other. Turning it off makes back a single discrete event
      again, and the spring animations here own the motion outright. Revisit
      only if predictive back is implemented end to end.
    -->
    <application
        android:name=".SpotKofiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotKofi">

        <service
            android:name=".data.service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Keeps audio alive once the app is minimised and publishes a platform
          MediaSession, which is what the system media controls, the lock screen
          and OEM floating/dynamic island surfaces read.
        -->
        <!--
          Not exported, and no MediaSessionService intent filter.

          This is a plain foreground service that owns a MediaSession; it is not a
          browsable media service, so there is nothing for another app to bind to.
          Exporting it would publish the transport actions below to every app on
          the device for no gain. Hardware media keys still work, because the
          platform routes them to the active MediaSession rather than to a
          component declared here.
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SpotKofi.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
