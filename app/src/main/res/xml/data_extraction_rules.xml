<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth tokens must never leave the device via backup. -->
        <exclude domain="sharedpref" path="spotkofi_session.xml" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotkofi_session.xml" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
    </device-transfer>
</data-extraction-rules>
