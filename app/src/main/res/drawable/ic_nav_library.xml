<?xml version="1.0" encoding="utf-8"?>
<!--
  "Your Library" icon, outlined state.
  Three upright book spines. Material's LibraryMusic is a stack of discs and
  reads nothing like the current app, so this is drawn by hand.
  Solid fill so Icon()'s tint can recolour it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M4,4 h2.6 v16 h-2.6 z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:fillColor="#00000000" />
    <path
        android:pathData="M10,4 h3.4 v16 h-3.4 z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:fillColor="#00000000" />
    <path
        android:pathData="M17,4 h3 v16 h-3 z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:fillColor="#00000000" />
</vector>
