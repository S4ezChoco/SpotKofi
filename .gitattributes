# Normalise line endings so the repo is identical on every machine.
* text=auto eol=lf

# gradlew is executed by /bin/sh on Unix and CRLF breaks the shebang, so it must
# stay LF regardless of the checkout platform.
gradlew text eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries git must not touch.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
